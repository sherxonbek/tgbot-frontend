# Backend API URL
VITE_API_URL=https://tgbot-backend-r3ei.onrender.com/api/users

# Socket.io Server URL
VITE_SOCKET_URL=https://tgbot-backend-r3ei.onrender.com

# 🔴 17-FIX: Cloudinary unsigned upload preset — MAJBURIY sozlanishi kerak!
# Cloudinary dashboard: Settings → Upload → Add upload preset → Signing Mode: Unsigned
# preset nomini shu yerga yozing. Default 'ml_default' ishlamaydi (maxsus preset talab qilinadi).
# Bu ikki o'zgaruvchi bo'lmasa rasm/audio yuklash ishlamaydi.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
